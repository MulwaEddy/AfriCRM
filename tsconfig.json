{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./",
    "checkJs": false
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "server.js"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
